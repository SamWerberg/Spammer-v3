local function isTagged(text)
	local success, filtered = pcall(function()
		return ChatService:FilterStringForBroadcast(
			text,
			Player,
			Player.UserId
		)
	end)

	if not success or not filtered then
		return true
	end

	return filtered ~= text
end

startBtn.MouseButton1Click:Connect(function()
	if spamming then
		return
	end

	local delayValue = tonumber(speedBox.Text)

	if delayValue and delayValue > 0 then
		spamDelay = math.max(0.1, delayValue)
	end

	saveCurrentSlot()

	-- FIX:
	-- Invalidate every previous loop and create a new unique ID.
	spamLoopId += 1
	local thisLoopId = spamLoopId

	spamming = true

	task.spawn(function()
		local index = 1
		local recentMessages = {}

		while spamming and thisLoopId == spamLoopId do
			local messages = getMessages()

			if #messages > 0 then
				local msg

				if randomMode then
					local available = {}

					for _, message in ipairs(messages) do
						if not recentMessages[message] then
							table.insert(available, message)
						end
					end

					if #available == 0 then
						recentMessages = {}

						for _, message in ipairs(messages) do
							table.insert(available, message)
						end
					end

					msg = available[math.random(1, #available)]
					recentMessages[msg] = true

					local recentCount = 0

					for _ in pairs(recentMessages) do
						recentCount += 1
					end

					if recentCount > math.max(2, math.floor(#messages * 0.6)) then
						local keys = {}

						for key in pairs(recentMessages) do
							table.insert(keys, key)
						end

						if #keys > 0 then
							recentMessages[keys[math.random(1, #keys)]] = nil
						end
					end
				else
					if index > #messages then
						index = 1
					end

					msg = messages[index]
					index += 1

					if index > #messages then
						index = 1
					end
				end

				if msg and msg ~= "" then
					if not tagDetection or not isTagged(msg) then
						pcall(function()
							Channel:SendAsync(msg)
						end)
					end
				end
			end

			-- Check the loop ID before waiting again.
			if not spamming or thisLoopId ~= spamLoopId then
				break
			end

			task.wait(spamDelay)
		end
	end)
end)

