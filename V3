local function refreshSlots()
	for _, child in ipairs(slotScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for number, slot in ipairs(SaveData.Slots) do
		local holder = Instance.new("Frame")
		holder.Parent = slotScroll
		holder.Size = UDim2.new(1, -10, 0, 55)
		holder.BackgroundTransparency = 1

		local loadButton = Instance.new("TextButton")
		loadButton.Parent = holder
		loadButton.Size = UDim2.new(0.7, 0, 1, 0)
		loadButton.Position = UDim2.new(0, 0, 0, 0)
		loadButton.Text = "Slot " .. number .. "  -  " .. tostring(slot.Name or "Unnamed")
		loadButton.TextScaled = true
		loadButton.TextXAlignment = Enum.TextXAlignment.Left
		loadButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		loadButton.TextColor3 = Color3.new(1, 1, 1)
		Instance.new("UICorner", loadButton)

		loadButton.MouseButton1Click:Connect(function()
			loadSlot(number)

			home.Visible = false
			editor.Visible = true
		end)

		local deleteButton = Instance.new("TextButton")
		deleteButton.Parent = holder
		deleteButton.Size = UDim2.new(0.25, 0, 1, 0)
		deleteButton.Position = UDim2.new(0.74, 0, 0, 0)
		deleteButton.Text = "X"
		deleteButton.TextScaled = true
		deleteButton.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
		deleteButton.TextColor3 = Color3.new(1, 1, 1)
		Instance.new("UICorner", deleteButton)

		deleteButton.MouseButton1Click:Connect(function()
			if currentSlot == number then
				currentSlot = nil

				-- Invalidate the active spam loop.
				spamLoopId += 1
				spamming = false
			end

			table.remove(SaveData.Slots, number)

			if SaveData.LastSlot == number then
				SaveData.LastSlot = nil
			elseif SaveData.LastSlot and SaveData.LastSlot > number then
				SaveData.LastSlot -= 1
			end

			Save()
			refreshSlots()
		end)
	end

	updateSlotCanvas()
end

