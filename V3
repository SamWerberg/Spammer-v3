local Folder = "SAMS_SCRIPT_HUB"
local File = Folder .. "/Slots.json"

local SaveData = {
	Slots = {},
	LastSlot = nil
}

local function Save()
	if not writefile then
		return
	end

	pcall(function()
		if not isfolder(Folder) then
			makefolder(Folder)
		end

		writefile(File, HttpService:JSONEncode(SaveData))
	end)
end

local function Load()
	if not isfile or not isfile(File) then
		return
	end

	local success, data = pcall(function()
		return HttpService:JSONDecode(readfile(File))
	end)

	if success and type(data) == "table" then
		if type(data.Slots) == "table" then
			SaveData.Slots = data.Slots
		end

		if data.LastSlot ~= nil then
			SaveData.LastSlot = data.LastSlot
		end
	end
end

