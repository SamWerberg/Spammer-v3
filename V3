local function getMessages()
	local messages = {}

	for _, box in ipairs(textboxes) do
		if box and box.Parent and box.Text ~= "" then
			table.insert(messages, box.Text)
		end
	end

	return messages
end

local function saveCurrentSlot()
	if not currentSlot then
		return
	end

	local slot = SaveData.Slots[currentSlot]

	if not slot then
		return
	end

	slot.Phrases = getMessages()
	slot.Delay = tonumber(speedBox.Text) or 1
	slot.TagDetection = tagDetection
	slot.RandomMode = randomMode

	SaveData.LastSlot = currentSlot

	Save()
end

saveBtn.MouseButton1Click:Connect(function()
	saveCurrentSlot()
end)

local function loadSlot(number)
	local slot = SaveData.Slots[number]

	if not slot then
		return
	end

	-- Invalidate any existing spam loop.
	spamLoopId += 1
	spamming = false

	currentSlot = number
	SaveData.LastSlot = number

	clearBoxes()

	if type(slot.Phrases) == "table" and #slot.Phrases > 0 then
		for _, phrase in ipairs(slot.Phrases) do
			addBox(tostring(phrase))
		end
	else
		addBox()
	end

	speedBox.Text = tostring(slot.Delay or 1)

	tagDetection = slot.TagDetection ~= false
	randomMode = slot.RandomMode == true

	if tagDetection then
		tagBtn.Text = "Tag Detection: ON"
		tagBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
	else
		tagBtn.Text = "Tag Detection: OFF"
		tagBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	end

	if randomMode then
		randomBtn.Text = "Random Phrases: ON"
		randomBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
	else
		randomBtn.Text = "Random Phrases: OFF"
		randomBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	end

	Save()
end

